# waybase answers file: sh install.sh answers.example
# Any variable left out is asked for interactively.
BASE=alpine               # kiss | gentoo | arch | alpine
COMPOSITOR=sway           # sway | river | labwc | dwl (a list installs several)
DISK=/dev/vda             # ALL DATA ON IT IS ERASED
YES=1                     # skip the "type the disk name again" check
ENCRYPT=yes               # LUKS2 on the root partition
LUKS_PASS=change-me
USERNAME=user
USER_PASS=change-me
ROOT_PASS=change-me
HOSTNAME_NEW=waybase
#FIRMWARE=no              # skip linux-firmware (VMs)
#SERIAL=1                 # console and login on ttyS0 (tests)
#NIXPKGS=github:NixOS/nixpkgs/nixos-unstable
